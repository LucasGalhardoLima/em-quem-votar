generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Legacy models (kept temporarily for backwards compatibility)
// ============================================================

model Politician {
  id       String  @id @default(uuid())
  name     String
  party    String
  state    String
  photoUrl String?

  attendanceRate Float?
  spending       Decimal?

  votes VoteLog[]
  tags  PoliticianTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([party])
  @@index([state])
  @@index([state, party])
}

model PoliticianTag {
  politicianId String
  tagId        String

  politician Politician @relation(fields: [politicianId], references: [id])
  tag        Tag        @relation(fields: [tagId], references: [id])

  @@id([politicianId, tagId])
  @@index([tagId])
  @@index([politicianId])
}

model VoteLog {
  id           String @id @default(uuid())
  politicianId String
  billId       String
  voteType     String

  politician Politician @relation(fields: [politicianId], references: [id])
  bill       Bill       @relation(fields: [billId], references: [id])

  @@unique([politicianId, billId])
  @@index([politicianId])
  @@index([billId])
}

// ============================================================
// New models for 2026 Presidential Platform
// ============================================================

enum RegistrationStatus {
  PRE_CANDIDATE
  REGISTERED
  PENDING_JUDGMENT
  SUB_JUDICE
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum PositionSourceType {
  PLATFORM
  PUBLIC_STATEMENT
  VOTE_RECORD
  INTERVIEW
  MANUAL
}

enum LegislativeSource {
  CAMARA
  SENADO
}

enum SpendingType {
  CEAP
  CAMPAIGN
  DECLARED_ASSETS
}

model Candidate {
  id                 String             @id @default(uuid())
  name               String
  displayName        String
  party              String
  coalition          String?
  photoUrl           String?
  biography          String?            @db.Text
  registrationStatus RegistrationStatus @default(PRE_CANDIDATE)
  /// Texto literal da situação conforme o TSE (DS_SITUACAO_CANDIDATO).
  /// Exibido no badge sem reescrita — ver app/lib/candidate-status.ts.
  tseStatusLabel     String?
  tseStatusDetail    String?
  tseId              String?            @unique
  /// Aptidão da candidatura segundo o TSE, em TRÊS estados:
  ///   `true`  — apta (a Justiça Eleitoral deferiu o registro)
  ///   `false` — inapta (indeferido, cassado, renúncia)
  ///   `null`  — AINDA NÃO JULGADA
  ///
  /// O `null` não é dado faltando: é o estado real da maioria das
  /// candidaturas durante boa parte do período eleitoral, e apagá-lo seria
  /// afirmar um veredito que não existe.
  ///
  /// ARMADILHA, verificada em 27/08/2026 nas 13 candidaturas presidenciais:
  /// o DivulgaCandContas devolve `candidatoApto: false` E
  /// `isCandidatoInapto: false` ao mesmo tempo para quem está "Aguardando
  /// julgamento" — 11 das 13. Ler `candidatoApto` como booleano marcaria 11
  /// pessoas como inaptas sem que nenhuma decisão tenha sido proferida. A
  /// derivação dos três estados mora em app/lib/candidate-status.ts.
  tseApto            Boolean?
  /// Número do processo de registro de candidatura (RCand) no TSE. É o que
  /// permite ao leitor abrir a decisão da Justiça Eleitoral e conferir a
  /// situação na fonte, em vez de acreditar no nosso badge.
  tseProcessNumber   String?
  /// Quantos bens a FICHA do TSE declara, em TRÊS estados:
  ///   `N > 0` — a ficha lista N bens
  ///   `0`     — a ficha respondeu com a lista VAZIA: não declara bem algum
  ///   `null`  — NÃO SABEMOS: ou a ficha nunca foi lida para esta
  ///             candidatura, ou respondeu sem a chave `bens`
  ///
  /// SEM `@default`, e isso não é descuido: `0` aqui é uma AFIRMAÇÃO sobre
  /// uma pessoa real — "o TSE não lista bem algum" —, então carimbar zero na
  /// criação faria o banco alegar isso sobre as 211 candidaturas antes de
  /// qualquer leitura. Ausência tem de continuar parecendo ausência.
  ///
  /// A contagem sai do payload CRU, dentro de `parseDivulgaDetail`, e NUNCA
  /// de `detail.bens.length`: o parser descarta item sem descrição ou sem
  /// valor, e a escrita descarta bem sem data (`assetsSkippedNoDate`).
  /// Contar depois de qualquer um dos dois filtros diria "a lista não veio"
  /// sobre uma ficha que veio com lista — que é exatamente o erro que esta
  /// coluna existe para impedir.
  tseAssetsDeclared  Int?
  /// Quantas candidaturas ANTERIORES a ficha do TSE declara, nos mesmos três
  /// estados de `tseAssetsDeclared` e sem `@default` pela mesma razão.
  ///
  /// É a contagem crua MENOS as linhas cujo id é o da própria candidatura:
  /// o DivulgaCandContas devolve a candidatura de 2026 dentro de
  /// `eleicoesAnteriores` (verificado nas 13 presidenciais em 27/08/2026).
  /// Contar cru faria a página dizer "a ficha lista 1 candidatura anterior
  /// que não pudemos exibir" sobre quem não tem antecedente nenhum.
  tsePriorElectionsDeclared Int?
  /// Cargo em disputa: "presidential" | "governor".
  /// Só esses dois: são os únicos cargos desta eleição para os quais a Lei
  /// 9.504/97 (art. 11, §1º, IX) obriga o registro de proposta de governo —
  /// e sem documento arquivado não há como sustentar uma posição com fonte.
  electionType       String             @default("presidential")
  /// UF da disputa. `null` para Presidente, que é de âmbito nacional.
  /// Para governador é obrigatória: o número de urna se repete entre estados,
  /// então o recorte de listagem e de filtro é (electionType, uf), nunca o
  /// número sozinho.
  uf                 String?
  /// Número de urna. NÃO identifica a chapa, nem sequer junto de
  /// (electionType, uf) — e é por isso que não existe `@@unique` aqui.
  ///
  /// Verificado no banco em 27/08/2026: 4 colisões reais em (electionType,
  /// uf, number), de duas naturezas diferentes.
  ///
  ///   Substituição de chapa — o número fica com o partido, a pessoa muda, e
  ///   as duas linhas coexistem porque a antiga guarda a decisão do TSE:
  ///     PA nº 16 (PSTU)  José Cleber Barros Rabelo (Renúncia)
  ///                      × Wellingta Josyane Siqueira Macedo (Aguardando)
  ///     CE nº 30 (NOVO)  Pedro Felipe Pinheiro Brito (Renúncia)
  ///                      × Vera Lucia da Silva (Aguardando)
  ///     BA nº 27 (DC)    Ariel da Silva Capistrano (Deferido com recurso)
  ///                      × José Estêvão dos Santos Barbosa (Indeferido em
  ///                        prazo recursal ou com recurso)
  ///
  ///   Registro duplicado do próprio TSE — a MESMA pessoa em dois SQ_CANDIDATO:
  ///     MT nº 36 (AGIR)  Laudicerio Aguiar Machado, tseId 110002553937
  ///                      e 110002554073, ambos "Aguardando julgamento"
  ///
  /// Um `@@unique` faria o `npm run sync:tse` falhar na linha e parar de
  /// importar as candidaturas seguintes — ou, pior, obrigaria o script a
  /// escolher qual das duas apagar, decidindo por conta própria o desfecho de
  /// um registro real. A chave de upsert é `tseId`, e só ela.
  number             Int?

  // Chapa
  viceName         String?
  viceParty        String?
  coalitionParties String[] @default([])

  // Documentos oficiais
  governmentPlanUrl String?
  officialSiteUrl   String?
  socialLinks       Json?

  // Procedência do registro: "tse" | "press" | "manual".
  // Enquanto o sync do TSE não roda, "press" sinaliza dado apurado em
  // fonte jornalística e obriga a exibição de sourceUrl na interface.
  dataSource   String    @default("manual")
  sourceUrl    String?
  lastSyncedAt DateTime?

  positions       CandidatePosition[]
  tags            CandidateTag[]
  legislativeLink CandidateLegislativeLink?
  spendingRecords SpendingRecord[]
  votes           VoteRecord[]
  electionHistory CandidateElectionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([party])
  @@index([registrationStatus])
  @@index([electionType])
  @@index([electionType, registrationStatus])
  @@index([electionType, uf])
  @@index([uf])
}

model PoliticalTopic {
  id          String  @id @default(uuid())
  name        String
  category    String
  slug        String  @unique
  description String?
  order       Int     @default(0)

  positions     CandidatePosition[]
  quizQuestions QuizQuestion[]
}

model CandidatePosition {
  id             String             @id @default(uuid())
  candidateId    String
  topicId        String
  stance         Int                @default(0) // 0=unknown, 1-5 Likert scale
  description    String?            @db.Text
  sourceType     PositionSourceType
  sourceUrl      String?
  sourceDate     DateTime?
  /// Nome do documento citado, ex.: "Proposta de governo — TSE".
  sourceDocument String?
  /// Página do PDF onde o trecho aparece. Obrigatória para sourceType PLATFORM.
  sourcePage     Int?
  /// Citação literal que sustenta a posição. Nunca parafraseada.
  sourceQuote    String?            @db.Text
  confidence     Float?
  approvedAt     DateTime?

  candidate Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic     PoliticalTopic @relation(fields: [topicId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, topicId])
  @@index([topicId])
}

model Tag {
  id          String  @id @default(uuid())
  name        String
  category    String
  slug        String  @unique
  description String?

  politicians PoliticianTag[]
  candidates  CandidateTag[]
}

model CandidateTag {
  candidateId String
  tagId       String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([candidateId, tagId])
  @@index([tagId])
  @@index([candidateId])
}

model CandidateLegislativeLink {
  id                String            @id @default(uuid())
  candidateId       String            @unique
  sourceType        LegislativeSource
  sourceId          String
  legislaturePeriod String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
}

/// Disputas eleitorais anteriores, como o próprio TSE as registra
/// (`eleicoesAnteriores` no DivulgaCandContas). Responde "esta pessoa já
/// disputou alguma coisa, e o que aconteceu?" sem que a plataforma precise
/// julgar carreira de ninguém.
///
/// `resultLabel` guarda a redação LITERAL do TSE e nunca é reescrita, pela
/// mesma razão de `tseStatusLabel`. Isso importa mais do que parece: em
/// 27/08/2026 o TSE registra a candidatura presidencial de 2018 de uma das
/// 13 como "Concorrendo", quando o registro havia sido indeferido. Traduzir
/// isso para "concorreu" publicaria uma afirmação falsa; exibir a palavra do
/// TSE ao lado do link para o registro deixa o leitor conferir a fonte.
model CandidateElectionHistory {
  id          String  @id @default(uuid())
  candidateId String
  /// `id` daquela candidatura antiga no TSE (SQ_CANDIDATO). É a chave que
  /// torna o sync idempotente — ano+cargo não bastam, porque a mesma pessoa
  /// pode disputar dois cargos no mesmo ano.
  tsePriorId  String
  year        Int
  /// Cargo disputado, redação do TSE: "Presidente", "Senador",
  /// "Deputado Estadual", "Vice-Prefeito"…
  office      String
  /// Unidade eleitoral do TSE. Nem sempre é UF: para cargo municipal vem o
  /// código do município (ex.: "71072"), e é assim que fica guardado.
  ue          String?
  party       String?
  /// Literal do TSE: "Eleito", "Não eleito", "Eleito por QP", "Concorrendo".
  resultLabel String
  /// Link do TSE para aquele registro, quando a API o fornece.
  sourceUrl   String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, tsePriorId])
  @@index([candidateId])
  @@index([year])
}

model Bill {
  id             String   @id
  title          String
  description    String?
  voteSimDetails String?
  voteNaoDetails String?
  voteDate       DateTime

  status            String    @default("pending")
  aiConfidence      Float?
  suggestedTagSim   String?
  suggestedTagNao   String?
  suggestedCategory String?
  approvedAt        DateTime?
  lastSyncAt        DateTime?

  simplifiedTitle       String?
  simplifiedDescription String? @db.Text

  sourceUrl  String?
  sourceType String  @default("camara") // "camara" | "senado"

  voteLogs    VoteLog[]
  voteRecords VoteRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voteDate])
  @@index([status])
  @@index([sourceType])
}

model VoteRecord {
  id          String @id @default(uuid())
  candidateId String
  billId      String
  /// Redação da fonte em CAIXA ALTA, como `scripts/sync-votacoes.ts` grava
  /// (`voto.tipoVoto.toUpperCase()`): "SIM", "NÃO", "ABSTENÇÃO",
  /// "OBSTRUÇÃO", "ARTIGO 17". Uma convenção só, e é esta — o comentário
  /// anterior documentava Title Case ("Sim", "Não") e nenhuma linha do banco
  /// jamais foi gravada assim.
  ///
  /// A lista NÃO é fechada: "ARTIGO 17" é a grafia literal que a Câmara
  /// devolve e tem 38 registros em `VoteLog` (27/08/2026). Quem consome
  /// agrupa pela chave canônica de `voteKey()` em `app/services/bill.server.ts`
  /// (sem acento, sem caixa) e exibe o rótulo literal — comparar com `===`
  /// contra uma das grafias já zerou um placar em produção.
  ///
  /// A tabela está VAZIA hoje (0 linhas, verificado em 27/08/2026); quem a
  /// popular segue esta convenção, não a antiga.
  voteType    String
  sourceType  String @default("camara") // "camara" | "senado"

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  bill      Bill      @relation(fields: [billId], references: [id])

  @@unique([candidateId, billId])
  @@index([candidateId])
  @@index([billId])
}

model SpendingRecord {
  id          String       @id @default(uuid())
  candidateId String
  type        SpendingType
  amount      Decimal
  periodStart DateTime
  periodEnd   DateTime
  category    String?
  source      String
  sourceUrl   String?
  /// Descrição do item como o próprio declarante a escreveu, ex.: "50% DO
  /// APARTAMENTO LOCALIZADO EM SÃO BERNARDO DO CAMPO". Existe para os bens
  /// declarados (`DECLARED_ASSETS`), onde a `category` guarda só o tipo do
  /// bem ("Apartamento", "Terreno") e o item perderia o sentido sem o texto.
  /// Copiada literal do TSE — descrever um bem com nossas palavras seria
  /// interpretar patrimônio de uma pessoa real.
  description String?      @db.Text

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([candidateId, type])
}

model QuizQuestion {
  id       String  @id @default(uuid())
  text     String
  topicId  String
  order    Int     @default(0)
  isActive Boolean @default(true)

  topic   PoliticalTopic @relation(fields: [topicId], references: [id])
  options QuizOption[]

  @@index([topicId])
  @@index([order])
}

model QuizOption {
  id          String  @id @default(uuid())
  questionId  String
  label       String
  description String?
  stanceValue Int // 1-5 Likert scale
  order       Int     @default(0)
  icon        String?

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}
