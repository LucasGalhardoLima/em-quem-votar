generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Legacy models (kept temporarily for backwards compatibility)
// ============================================================

model Politician {
  id        String   @id @default(uuid())
  name      String
  party     String
  state     String
  photoUrl  String?

  attendanceRate Float?
  spending       Decimal?

  votes     VoteLog[]
  tags      PoliticianTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([party])
  @@index([state])
  @@index([state, party])
}

model PoliticianTag {
  politicianId String
  tagId        String

  politician   Politician @relation(fields: [politicianId], references: [id])
  tag          Tag        @relation(fields: [tagId], references: [id])

  @@id([politicianId, tagId])
  @@index([tagId])
  @@index([politicianId])
}

model VoteLog {
  id           String @id @default(uuid())
  politicianId String
  billId       String
  voteType     String

  politician   Politician @relation(fields: [politicianId], references: [id])
  bill         Bill       @relation(fields: [billId], references: [id])

  @@index([politicianId])
  @@index([billId])
  @@unique([politicianId, billId])
}

// ============================================================
// New models for 2026 Presidential Platform
// ============================================================

enum RegistrationStatus {
  PRE_CANDIDATE
  REGISTERED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PositionSourceType {
  PLATFORM
  PUBLIC_STATEMENT
  VOTE_RECORD
  INTERVIEW
  MANUAL
}

enum LegislativeSource {
  CAMARA
  SENADO
}

enum SpendingType {
  CEAP
  CAMPAIGN
  DECLARED_ASSETS
}

model Candidate {
  id                 String             @id @default(uuid())
  name               String
  displayName        String
  party              String
  coalition          String?
  photoUrl           String?
  biography          String?            @db.Text
  registrationStatus RegistrationStatus @default(PRE_CANDIDATE)
  tseId              String?            @unique
  electionType       String             @default("presidential")
  number             Int?

  positions       CandidatePosition[]
  tags            CandidateTag[]
  legislativeLink CandidateLegislativeLink?
  spendingRecords SpendingRecord[]
  votes           VoteRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([party])
  @@index([registrationStatus])
  @@index([electionType])
}

model PoliticalTopic {
  id          String  @id @default(uuid())
  name        String
  category    String
  slug        String  @unique
  description String?
  order       Int     @default(0)

  positions     CandidatePosition[]
  quizQuestions QuizQuestion[]
}

model CandidatePosition {
  id          String             @id @default(uuid())
  candidateId String
  topicId     String
  stance      Int                @default(0) // 0=unknown, 1-5 Likert scale
  description String?            @db.Text
  sourceType  PositionSourceType
  sourceUrl   String?
  sourceDate  DateTime?
  confidence  Float?
  approvedAt  DateTime?

  candidate Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic     PoliticalTopic @relation(fields: [topicId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, topicId])
  @@index([topicId])
}

model Tag {
  id          String @id @default(uuid())
  name        String
  category    String
  slug        String @unique
  description String?

  politicians  PoliticianTag[]
  candidates   CandidateTag[]
}

model CandidateTag {
  candidateId String
  tagId       String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([candidateId, tagId])
  @@index([tagId])
  @@index([candidateId])
}

model CandidateLegislativeLink {
  id                String            @id @default(uuid())
  candidateId       String            @unique
  sourceType        LegislativeSource
  sourceId          String
  legislaturePeriod String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
}

model Bill {
  id          String   @id
  title       String
  description String?
  voteSimDetails String?
  voteNaoDetails String?
  voteDate    DateTime

  status          String   @default("pending")
  aiConfidence    Float?
  suggestedTagSim String?
  suggestedTagNao String?
  suggestedCategory String?
  approvedAt      DateTime?
  lastSyncAt      DateTime?

  simplifiedTitle       String?
  simplifiedDescription String? @db.Text

  sourceUrl  String?
  sourceType String  @default("camara") // "camara" | "senado"

  voteLogs    VoteLog[]
  voteRecords VoteRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voteDate])
  @@index([status])
  @@index([sourceType])
}

model VoteRecord {
  id          String @id @default(uuid())
  candidateId String
  billId      String
  voteType    String // "Sim", "Não", "Abstenção", "Obstrução"
  sourceType  String @default("camara") // "camara" | "senado"

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  bill      Bill      @relation(fields: [billId], references: [id])

  @@unique([candidateId, billId])
  @@index([candidateId])
  @@index([billId])
}

model SpendingRecord {
  id          String       @id @default(uuid())
  candidateId String
  type        SpendingType
  amount      Decimal
  periodStart DateTime
  periodEnd   DateTime
  category    String?
  source      String
  sourceUrl   String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([candidateId, type])
}

model QuizQuestion {
  id       String  @id @default(uuid())
  text     String
  topicId  String
  order    Int     @default(0)
  isActive Boolean @default(true)

  topic   PoliticalTopic @relation(fields: [topicId], references: [id])
  options QuizOption[]

  @@index([topicId])
  @@index([order])
}

model QuizOption {
  id          String  @id @default(uuid())
  questionId  String
  label       String
  description String?
  stanceValue Int     // 1-5 Likert scale
  order       Int     @default(0)
  icon        String?

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ============================================================
// Preserved models
// ============================================================

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model UserProfile {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  photoUrl        String?

  quizAnswers     Json?
  politicalVector Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
