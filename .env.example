# ─── Banco (Supabase / PostgreSQL) ───────────────────────────────────────────
# DATABASE_URL usa o pooler; DIRECT_URL é a conexão direta, usada pelas
# migrations. Ambas vêm do painel do Supabase em Project Settings → Database.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<senha>@<host>:5432/postgres"

# ─── Painel /admin ───────────────────────────────────────────────────────────
# OBRIGATÓRIA em produção. Sem ela, /admin responde 503 (falha fechado).
# Em desenvolvimento, se estiver ausente o painel fica liberado e o servidor
# emite um aviso no log.
# A chave que assina o cookie de sessão é DERIVADA daqui com scrypt (não é a
# senha crua). Consequência: trocar esta variável revoga toda sessão aberta.
ADMIN_PASSWORD=""
# Opcional; o padrão é "admin".
ADMIN_USER="admin"

# ─── Cron do Vercel ──────────────────────────────────────────────────────────
# OBRIGATÓRIA em produção: /api/cron/tse-status grava no banco, e sem o
# segredo qualquer um dispararia a rota (ela responde 503 se faltar).
# Você cria esta variável no painel do Vercel; a partir daí o Vercel Cron
# passa a mandar `Authorization: Bearer <valor>` sozinho em cada disparo.
# Sem a variável, o cron chama a rota sem header e leva 401 em produção.
# Para chamar à mão: `curl -H "Authorization: Bearer $CRON_SECRET" ...`.
CRON_SECRET=""

# ─── Supabase (cliente) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""

# ─── Analytics (opcional) ────────────────────────────────────────────────────
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST=""

# ─── Classificação de votações por IA (scripts, opcional) ────────────────────
# Usada só por scripts/ para simplificar ementas. A aplicação não depende dela.
OPENAI_API_KEY=""

# ─── Alertas do sync diário por e-mail (scripts/daily-sync.ts) ───────────────
# Sem SMTP_HOST/SMTP_USER/SMTP_PASS o script apenas não manda o alerta — o
# sync em si continua rodando. Em CI, os valores vêm dos secrets do repositório
# (.github/workflows/daily-sync.yml).
SMTP_HOST=""
SMTP_PORT="587"        # 465 liga TLS implícito; qualquer outra porta usa STARTTLS
SMTP_USER=""
SMTP_PASS=""
# Ambos opcionais; o padrão dos dois é SMTP_USER.
ALERT_EMAIL_FROM=""
ALERT_EMAIL_TO=""

# ─── Agente de discovery no Linear (scripts/pm-discovery-agent.ts) ───────────
# Só a API key é obrigatória para o script rodar; o resto tem padrão embutido.
# Em CI vêm dos secrets (.github/workflows/pm-discovery.yml).
LINEAR_API_KEY=""
LINEAR_TEAM_ID=""                 # padrão: o time já cadastrado no script
LINEAR_PROJECT_NAME=""            # padrão: "Em Quem Votar - Product Discovery"
LINEAR_DIGEST_TITLE=""            # padrão: "Discovery Daily Digest"
LINEAR_BACKLOG_STATE=""           # padrão: "Backlog"

# ─── Vercel Blob (scripts/upload-planos-blob.ts) ─────────────────────────────
# Usada só pelo `npm run upload:planos`, que sobe os planos de governo.
# Puxe com `npx vercel env pull .env.local` em vez de copiar à mão.
BLOB_READ_WRITE_TOKEN=""
